# ---- Stage 1: Install dependencies ---
# Node 20 is too old for pnpm 11 (requires Node >= 22.13). Use Node 22 LTS.
FROM node:22-slim AS build
WORKDIR /app

# Pin pnpm exactly so the build is reproducible and won't drift onto a build-script
# policy or runtime change. pnpm 11 reads `allowBuilds` from pnpm-workspace.yaml.
RUN npm i -g pnpm@11.24.0

# pnpm-workspace.yaml MUST be copied too: it holds the `allowBuilds` config that
# approves native dependency build scripts (Prisma, esbuild, sharp, unrs-resolver,
# msw). Without it pnpm 10.5+/11 refuses those builds with ERR_PNPM_IGNORED_BUILDS.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

# ---- Stage 2: Build the app ----
FROM node:22-slim AS production
WORKDIR /app

RUN npm i -g pnpm@11.24.0

COPY --from=build /app/node_modules ./node_modules
COPY . .


ARG BASE_API_URL
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_IBS_API_URL

ENV BASE_API_URL=$BASE_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_IBS_API_URL=$NEXT_PUBLIC_IBS_API_URL

RUN pnpm run build

# ---- Stage 3: Production runner ----
FROM node:22-slim AS runner
WORKDIR /app

ENV NODE_ENV=production

ENV PORT=3456 

# Copy standalone output + static/public assets
COPY --from=production /app/.next/standalone ./
COPY --from=production /app/.next/static ./.next/static
COPY --from=production /app/public ./public

EXPOSE 3456

CMD ["node", "server.js"]
